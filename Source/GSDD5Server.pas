function GetGSDDServiceSoap(UseWSDL: Boolean=System.False; Addr: string=''; HTTPRIO: THTTPRIO = nil): GSDDServiceSoap;


implementation
  uses System.SysUtils, UntMain;

function GetGSDDServiceSoap(UseWSDL: Boolean; Addr: string; HTTPRIO: THTTPRIO): GSDDServiceSoap;
const
  defWSDL = 'http://10.0.0.5:3434/Server.wsdl';
  defURL  = 'http://gsdd:3434/gsdd';
  defSvc  = 'GSDDService';
  defPrt  = 'GSDDServiceSoap';
var
  RIO: THTTPRIO;
begin
  Result := nil;
  if (Addr = '') then
  begin
    if UseWSDL then
      Addr := defWSDL
    else
      Addr := defURL;
  end;
  Addr := FrmMain.GoldStandardDB;
  if HTTPRIO = nil then
    RIO := THTTPRIO.Create(nil)
  else
    RIO := HTTPRIO;
  try
    Result := (RIO as GSDDServiceSoap);
    if UseWSDL then
    begin
      RIO.WSDLLocation := Addr;
      RIO.Service := defSvc;
      RIO.Port := defPrt;
    end else
      RIO.URL := Addr;
  finally
    if (Result = nil) and (HTTPRIO = nil) then
      RIO.Free;
  end;
end;


