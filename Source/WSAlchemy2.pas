function GetAlchemyServiceSoap(UseWSDL: Boolean=System.False; Addr: string=''; HTTPRIO: THTTPRIO = nil): AlchemyServiceSoap;


implementation
  uses SysUtils, UntData, UntMain;

function GetAlchemyServiceSoap(UseWSDL: Boolean; Addr: string; HTTPRIO: THTTPRIO): AlchemyServiceSoap;
const
  defWSDL = 'http://192.168.3.251:3434/WSAlchemy.wsdl';
  //defURL  = 'http://192.168.1.225:3434/Alchemy';
  defSvc  = 'AlchemyService';
  defPrt  = 'AlchemyServiceSoap';
var
  RIO: THTTPRIO;
  defURL: String;
begin
  defURL := FrmMain.GoldStandardDB; //'http://192.168.3.251:3434/Alchemy';
  Result := nil;
  if (Addr = '') then
  begin
    if UseWSDL then
      Addr := defWSDL
    else
      Addr := defURL;
  end;
  if HTTPRIO = nil then
    RIO := THTTPRIO.Create(nil)
  else
    RIO := HTTPRIO;
  try
    Result := (RIO as AlchemyServiceSoap);
    if UseWSDL then
    begin
      RIO.WSDLLocation := Addr;
      RIO.Service := defSvc;
      RIO.Port := defPrt;
    end else
      RIO.URL := Addr;
  finally
    if (Result = nil) and (HTTPRIO = nil) then
      RIO.Free;
  end;
end;


